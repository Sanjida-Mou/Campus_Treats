<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingVertical="12dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <de.hdodenhof.circleimageview.CircleImageView
            android:id="@+id/reviewerProfileImageUser"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:src="@drawable/ic_person"
            app:civ_border_width="1dp"
            app:civ_border_color="@color/primary_green" />

        <TextView
            android:id="@+id/reviewerNameUser"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="12dp"
            android:text="Name"
            android:textColor="@color/text_black"
            android:textStyle="bold"
            android:textSize="14sp" />

        <RatingBar
            android:id="@+id/reviewRatingUser"
            style="?android:attr/ratingBarStyleSmall"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:numStars="5"
            android:progressTint="@color/accent_yellow" />
    </LinearLayout>

    <TextView
        android:id="@+id/reviewCommentUser"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="Comment"
        android:textColor="@color/text_black"
        android:textSize="14sp"
        android:alpha="0.8" />

    <LinearLayout
        android:id="@+id/reviewActionsLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="end"
        android:layout_marginTop="4dp"
        android:visibility="gone">

        <ImageView
            android:id="@+id/editReviewBtn"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@android:drawable/ic_menu_edit"
            app:tint="@color/primary_green"
            android:padding="4dp" />

        <ImageView
            android:id="@+id/deleteReviewBtn"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_marginStart="8dp"
            android:src="@android:drawable/ic_menu_delete"
            app:tint="@color/error_red"
            android:padding="4dp" />
    </LinearLayout>

    <!-- Admin Reply -->
    <LinearLayout
        android:id="@+id/replyLayoutUser"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:layout_marginStart="16dp"
        android:background="#F9F9F9"
        android:padding="8dp"
        android:orientation="vertical"
        android:visibility="gone">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Admin Reply:"
            android:textColor="@color/primary_green"
            android:textStyle="bold"
            android:textSize="11sp" />

        <TextView
            android:id="@+id/adminReplyUser"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="Reply message"
            android:textColor="@color/text_black"
            android:textSize="13sp"
            android:alpha="0.9" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#EEEEEE"
        android:layout_marginTop="12dp" />

</LinearLayout>