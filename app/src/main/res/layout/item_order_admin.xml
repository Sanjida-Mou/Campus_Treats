<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="8dp"
    app:cardCornerRadius="12dp"
    app:cardElevation="4dp"
    app:cardBackgroundColor="@color/white">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <de.hdodenhof.circleimageview.CircleImageView
                android:id="@+id/orderProfileImage"
                android:layout_width="50dp"
                android:layout_height="50dp"
                android:src="@drawable/ic_person"
                app:civ_border_width="2dp"
                app:civ_border_color="@color/primary_green" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="12dp"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/orderCustomerName"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Customer Name"
                    android:textColor="@color/text_black"
                    android:textSize="18sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <TextView
                android:id="@+id/orderStatusAdmin"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="PENDING"
                android:textStyle="bold"
                android:textColor="#FF9800"/>
        </LinearLayout>

        <TextView
            android:id="@+id/orderItems"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Items: Burger x 2, Pizza x 1"
            android:textColor="@color/text_black" />

        <TextView
            android:id="@+id/orderAddress"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Location: Hall Name, Room 302"
            android:textColor="@color/text_hint" />

        <TextView
            android:id="@+id/orderPayment"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Payment: Bkash"
            android:textColor="@color/primary_green"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/orderTrxId"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="TrxID: A1B2C3D4"
            android:textColor="@color/text_hint"
            android:textSize="12sp"
            android:visibility="gone" />

        <TextView
            android:id="@+id/orderTotal"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:layout_gravity="end"
            android:text="Total: Tk 120.00"
            android:textColor="@color/error_red"
            android:textSize="16sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="end"
            android:layout_marginTop="12dp">

            <Button
                android:id="@+id/btnUpdateStatus"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:text="Update Status"
                android:textSize="10sp"
                android:textAllCaps="false"
                android:backgroundTint="@color/primary_green"/>

            <Button
                android:id="@+id/btnVerifyPayment"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:layout_marginStart="8dp"
                android:text="Okay"
                android:textSize="10sp"
                android:textAllCaps="false"
                android:backgroundTint="@color/primary_green"
                android:visibility="gone"/>

            <Button
                android:id="@+id/btnRejectPayment"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:layout_marginStart="8dp"
                android:text="Cancel"
                android:textSize="10sp"
                android:textAllCaps="false"
                android:backgroundTint="@color/error_red"
                android:visibility="gone"/>

            <Button
                android:id="@+id/btnReturnPayment"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:layout_marginStart="8dp"
                android:text="Return Payment"
                android:textSize="10sp"
                android:textAllCaps="false"
                android:backgroundTint="@color/card_blue"
                android:visibility="gone"/>

            <Button
                android:id="@+id/btnDeleteOrder"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:layout_marginStart="8dp"
                android:text="Delete History"
                android:textSize="10sp"
                android:textAllCaps="false"
                android:backgroundTint="@color/text_hint"
                android:visibility="gone"/>
        </LinearLayout>

    </LinearLayout>
</androidx.cardview.widget.CardView>